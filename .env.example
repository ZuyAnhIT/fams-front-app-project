# URL backend thật (Spring Boot: http://localhost:8080/api/v1)
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
# Khi đổi Wi-Fi, chạy `npm run sync:lan` để tự phát hiện IP và đồng bộ file
# .env của app, .env.local của web, cùng .env của backend. Có thể chỉ định:
# `npm run sync:lan -- --ip 192.168.1.20`.

# HTTPS origin của frontend web dùng trong email và App Links/Universal Links.
# Chỉ nhập origin, không thêm path/query/port. Ví dụ: https://staging-app.fams.vn
# Để trống vẫn dùng được custom scheme trong development build.
EXPO_PUBLIC_APP_URL=

# Tùy chọn ghi đè endpoint upload avatar, cùng origin với API (ưu tiên relative path).
# Để trống app dùng endpoint chuẩn /auth/profile/avatar.
EXPO_PUBLIC_AVATAR_UPLOAD_URL=

# Google OAuth Web Client ID (cùng GOOGLE_CLIENT_ID trên backend)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# EAS file secret hoặc đường dẫn local tới Firebase config cho Android.
# Local mặc định dùng ./google-services.json nếu file tồn tại.
EXPO_ANDROID_GOOGLE_SERVICES_FILE=

# EAS file secret hoặc đường dẫn local tới Firebase plist cho bản build iOS.
# Có thể bỏ trống khi chỉ phát triển Web/Android.
EXPO_IOS_GOOGLE_SERVICES_FILE=

# REVERSED_CLIENT_ID của iOS OAuth client, dạng com.googleusercontent.apps....
# Giá trị phải khớp GoogleService-Info.plist và ios.bundleIdentifier=com.fams.mobile.
EXPO_PUBLIC_IOS_GOOGLE_URL_SCHEME=

# URL chính xác để trang verify/reset trên web mở lại ứng dụng mobile.
# Expo Go LAN: exp://<LAN_IP>:8082/--/login
# Development Build: famsfrontappproject://login
EXPO_PUBLIC_MOBILE_LOGIN_URL=

# Thời điểm backend chính thức chuyển embedding Face ID từ dlib 128 chiều sang
# ArcFace 512 chiều. App dùng mốc này để yêu cầu hồ sơ cũ đăng ký lại trước
# check-in. Cần đặt đúng thời điểm rollout của từng môi trường/EAS.
EXPO_PUBLIC_FACE_ID_ARCFACE_ROLLOUT_AT=2026-07-31T01:14:52Z
