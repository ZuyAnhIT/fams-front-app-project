# URL backend thật (Spring Boot: http://localhost:8080/api/v1)
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1

# Endpoint upload avatar do backend quản lý, cùng origin với API (ưu tiên relative path).
# Để trống sẽ vô hiệu hóa upload ảnh nhưng vẫn cho phép sửa thông tin khác.
EXPO_PUBLIC_AVATAR_UPLOAD_URL=

# Google OAuth Web Client ID (cùng GOOGLE_CLIENT_ID trên backend)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# EAS file secret hoặc đường dẫn local tới Firebase config cho Android.
# Local mặc định dùng ./google-services.json nếu file tồn tại.
EXPO_ANDROID_GOOGLE_SERVICES_FILE=

# EAS file secret hoặc đường dẫn local tới Firebase plist cho bản build iOS.
# Có thể bỏ trống khi chỉ phát triển Web/Android.
EXPO_IOS_GOOGLE_SERVICES_FILE=
